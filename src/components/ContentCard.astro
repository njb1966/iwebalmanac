---
import { entryUrl, formatDate } from "../lib/content.js";
import { getSection } from "../lib/sections.js";

const { item, compact = false } = Astro.props;
const section = getSection(item.section);
const data = item.entry.data;
---

<article class:list={["content-card", compact && "content-card--compact"]}>
  <div class="content-card__meta">
    <a href={`/${item.section}/`}>{section?.singular || item.section}</a>
    <span>{formatDate(data.date)}</span>
  </div>
  <h3><a href={entryUrl(item)}>{data.title}</a></h3>
  <p>{data.description}</p>
  {(data.author || data.editor) && (
    <p class="content-card__credit">
      {data.author ? `By ${data.author}` : `Edited by ${data.editor}`}
    </p>
  )}
</article>
